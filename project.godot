; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="CocktailMerge"
run/main_scene="res://scenes/campaign/ApplicationShellScene.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Spark="*res://addons/saltmire_spark/spark.gd"
GameFeelFlow="*uid://ckhnfaf1odnpl"
_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=800
window/size/window_height_override=1422
window/stretch/mode="viewport"
window/handheld/orientation=1

[editor_plugins]

enabled=PackedStringArray("res://addons/game_feel_flow/plugin.cfg", "res://addons/godot_ai/plugin.cfg", "res://addons/saltmire_spark/plugin.cfg", "res://addons/AdmobPlugin/plugin.cfg", "res://addons/GodotGooglePlayBilling/plugin.cfg")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
